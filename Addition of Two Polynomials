#include <stdio.h>

int main() {
    int p1[10], p2[10], sum[10];
    int degree1, degree2, maxDegree, i;

    printf("Enter degree of first polynomial: ");
    scanf("%d", &degree1);

    printf("Enter coefficients of first polynomial:\n");
    for (i = degree1; i >= 0; i--) {
        printf("Coefficient of x^%d: ", i);
        scanf("%d", &p1[i]);
    }

    printf("\nEnter degree of second polynomial: ");
    scanf("%d", &degree2);

    printf("Enter coefficients of second polynomial:\n");
    for (i = degree2; i >= 0; i--) {
        printf("Coefficient of x^%d: ", i);
        scanf("%d", &p2[i]);
    }

    // Find maximum degree
    maxDegree = (degree1 > degree2) ? degree1 : degree2;

    // Add polynomials
    for (i = 0; i <= maxDegree; i++) {
        sum[i] = p1[i] + p2[i];
    }

    // Display result
    printf("\nSum of polynomials: ");

    for (i = maxDegree; i >= 0; i--) {
        if (sum[i] != 0) {
            if (i == 0)
                printf("%d", sum[i]);
            else
                printf("%dx^%d + ", sum[i], i);
        }
    }

    return 0;
}
